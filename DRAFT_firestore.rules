rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Crucible Output Validation
    function isValidCrucibleOutput(data) {
      return data.keys().hasAll(['type', 'content', 'prompt', 'authorId', 'createdAt'])
        && data.keys().size() <= 7 // Allow metadata or other optional fields
        && data.type in ['image', 'audio', 'experiment']
        && data.content is string && data.content.size() <= 2000000 // Limit for base64
        && data.prompt is string && data.prompt.size() <= 1000
        && data.authorId == request.auth.uid
        && data.createdAt == request.time;
    }

    match /crucible_outputs/{outputId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn() 
        && isValidId(outputId)
        && isValidCrucibleOutput(incoming());
    }
  }
}
